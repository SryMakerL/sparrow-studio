<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>SparrowStudio.Core</PackageId>
    <Version>0.2.0</Version>
    <Description>Sparrow Studio app models and native nesting solver for .NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../include/sparrow_dotnet_native.h" Pack="true" PackagePath="include/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../web/public/THIRD_PARTY_NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="../../../native/dotnet-engine/target/release/sparrow_dotnet_native.dll"
          Link="sparrow_dotnet_native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="runtimes/win-x64/native/" />
  </ItemGroup>
  <Target Name="RequireNativeLibrary" BeforeTargets="Build;Pack">
    <Error Condition="!Exists('../../../native/dotnet-engine/target/release/sparrow_dotnet_native.dll')" Text="Build the native library first: cargo build --release --manifest-path native/dotnet-engine/Cargo.toml" />
  </Target>
</Project>
